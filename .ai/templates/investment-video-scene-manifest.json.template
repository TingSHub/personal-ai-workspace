        {
          "state_id": "{state_id}",
          "turn_id": "{turn_id}",
          "at": 0,
          "action": "{establish|reveal|connect|compare|challenge|resolve}",
          "target_ids": [],
          "hold_until": 0,
          "evidence_ids": []
        }
      ],
      "transition_out": {
        "type": "{push|focus-pull|crossfade|cut}",
        "duration": 0.5,
        "to_scene_id": "{next_scene_id_or_none}"
