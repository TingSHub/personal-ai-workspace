  "captions": "podcast/qa/captions.json",
  "timing_source": "podcast/audio/segments.json",
  "visual_system": {
    "profile_ref": "account-profile/design.md",
    "reference_ids": [],
    "design_dials": {
      "design_variance": 6,
      "motion_intensity": 6,
      "visual_density": 5
    }
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "mobile_first": true
  },
  "scenes": [
    {
      "scene_id": "{scene_id}",
      "topic_id": "{topic_id}",
