      "audio_cues": [
        {
          "cue_id": "{cue_id}",
          "state_id": "{state_id}",
          "asset_ref": "{local_asset_or_by_name_ref}",
          "gain_db": 0,
          "ducking_db": 0
        }
      ]
    }
  ]
